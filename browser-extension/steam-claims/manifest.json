{
  "manifest_version": 3,
  "name": "SWCH — магазин Steam для раздач",
  "version": "1.1.0",
  "description": "Подключает выбранный вход магазина Steam к локальному автоклеймеру SWCH.",
  "permissions": ["cookies"],
  "host_permissions": ["https://store.steampowered.com/*", "https://login.steampowered.com/*", "http://127.0.0.1/*", "http://localhost/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{
    "matches": ["http://127.0.0.1/steam/claim-connect*", "http://localhost/steam/claim-connect*"],
    "js": ["bridge.js"], "run_at": "document_idle"
  }]
}
